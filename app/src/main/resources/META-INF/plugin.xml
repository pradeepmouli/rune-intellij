<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. Must be unique across all plugins on the Marketplace. -->
    <id>com.github.pmouli.rune-intellij</id>

    <!-- Public plugin name should be written in Title Case. -->
    <name>Rune IntelliJ Plugin</name>

    <!-- Plugin vendor: your organization or your name -->
    <vendor email="support@example.com" url="https://github.com/pmouli/rune-intellij">pmouli</vendor>

    <!-- Description of the plugin displayed in the Marketplace and IDE settings. -->
    <description><![CDATA[
        A minimal IntelliJ Platform plugin built with Kotlin, following best practices for threading,
        PSI/VFS safety, and clean architecture.
    ]]></description>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.platform</depends>

    <!-- Extension points defined by this plugin -->
    <extensions defaultExtensionNs="com.intellij">
        <!-- Language and file type registration -->
        <fileType
            name="Rosetta"
            implementationClass="com.github.pmouli.rune.RosettaFileType"
            fieldName="INSTANCE"
            language="Rosetta"
            extensions="rosetta"/>
        
        <!-- Parser definition -->
        <lang.parserDefinition
            language="Rosetta"
            implementationClass="com.github.pmouli.rune.RosettaParserDefinition"/>
        
        <!-- Syntax highlighting -->
        <lang.syntaxHighlighterFactory
            language="Rosetta"
            implementationClass="com.github.pmouli.rune.highlight.RosettaSyntaxHighlighterFactory"/>
        
        <colorSettingsPage
            implementation="com.github.pmouli.rune.highlight.RosettaColorSettingsPage"/>
        
        <!-- Language features (US1) -->
        <completion.contributor
            language="Rosetta"
            implementationClass="com.github.pmouli.rune.completion.RosettaCompletionContributor"/>
        
        <annotator
            language="Rosetta"
            implementationClass="com.github.pmouli.rune.annotator.RosettaAnnotator"/>
        
        <psi.referenceContributor
            language="Rosetta"
            implementation="com.github.pmouli.rune.reference.RosettaReferenceContributor"/>
        
        <lang.documentationProvider
            language="Rosetta"
            implementationClass="com.github.pmouli.rune.doc.RosettaDocumentationProvider"/>
        
        <lang.psiStructureViewFactory
            language="Rosetta"
            implementationClass="com.github.pmouli.rune.structure.RosettaStructureViewFactory"/>
        
        <!-- Project configuration -->
        <projectConfigurable
            instance="com.github.pmouli.rune.settings.RuneSettingsConfigurable"
            displayName="Rune DSL"
            groupId="tools"/>
        
        <projectService
            serviceImplementation="com.github.pmouli.rune.settings.RuneProjectConfiguration"/>
    </extensions>

    <!-- Extension points and actions -->
    <actions>
        <action id="Rune.GeneratePreview"
                class="com.github.pmouli.rune.actions.GeneratePreviewAction"
                text="Generate Code Preview"
                description="Generate Java code from Rune DSL with preview">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
        
        <action id="Rune.HelloAction"
                class="com.github.pmouli.rune.actions.HelloAction"
                text="Hello Rune"
                description="Sample action to demonstrate Rune plugin">
            <add-to-group group-id="ToolsMenu" anchor="first"/>
        </action>
    </actions>
</idea-plugin>
